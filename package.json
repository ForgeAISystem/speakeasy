{
  "name": "speakeasy",
  "productName": "SpeakEasy",
  "version": "2.6.0",
  "description": "Local, private voice dictation for Mac and Windows. Hold a key, speak, release. Your words appear in any app. No cloud, no subscription.",
  "main": "src/main/index.js",
  "author": "Harsh Patel",
  "license": "MIT",
  "scripts": {
    "native": "node scripts/build-native.js",
    "prestart": "npm run native",
    "predist:mac": "npm run native",
    "predist": "npm run native",
    "test": "node --test tests/*.test.js",
    "start": "electron .",
    "icon": "electron scripts/render-icon.js",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@fontsource/bricolage-grotesque": "^5.2.10",
    "@fontsource/eb-garamond": "^5.2.7",
    "@fontsource/figtree": "^5.2.10",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "sherpa-onnx-node": "^1.13.3",
    "uiohook-napi": "^1.5.5"
  },
  "devDependencies": {
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^30.0.1"
  }
}
